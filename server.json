{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.prakharagarwal-dev/linkedin-mcp-server",
  "title": "LinkedIn MCP Server",
  "description": "Typed, policy-enforced local MCP capabilities over LinkedIn's visible web UI.",
  "repository": {
    "url": "https://github.com/prakharagarwal-dev/linkedin-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/prakharagarwal-dev/linkedin-mcp-server",
  "version": "0.14.2",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/prakharagarwal-dev/linkedin-mcp-server:0.14.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "--transport"
        },
        {
          "type": "positional",
          "value": "stdio"
        }
      ]
    }
  ]
}
