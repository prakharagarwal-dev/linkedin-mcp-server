LINKEDIN_MCP_ACCOUNT_ID=personal
LINKEDIN_MCP_LIVE_ENABLED=false

# Chromium is installed automatically into Playwright's native persistent cache.
LINKEDIN_MCP_BROWSER_AUTO_INSTALL=true
LINKEDIN_MCP_BROWSER_INSTALL_TIMEOUT_SECONDS=600
# The persistent profile saves the LinkedIn login across server restarts.
# Treat this directory as sensitive and never commit or share it.
# LINKEDIN_MCP_BROWSER_PROFILE_PATH=/an/optional/custom/profile
# Leave the native browser cache unchanged for local headed/headless session
# portability. Containers and operator-managed installations may override it.
# LINKEDIN_MCP_BROWSER_CACHE_PATH=/an/operator-managed/playwright-browsers
LINKEDIN_MCP_AUTO_LOGIN_ON_START=true

LINKEDIN_MCP_ALLOWED_HOSTS='["www.linkedin.com","linkedin.com"]'
LINKEDIN_MCP_ALLOWED_SURFACES='["job-search","job-detail","people-search","member-profile"]'
LINKEDIN_MCP_ALLOWED_SCOPES='["linkedin.jobs.search","linkedin.jobs.read","linkedin.people.search","linkedin.people.read"]'
LINKEDIN_MCP_ALLOWED_EFFECTS='["read"]'
# Explicit opt-in example for Company research:
# LINKEDIN_MCP_ALLOWED_SURFACES='["job-search","job-detail","people-search","member-profile","company-search","company-profile","company-about"]'
# LINKEDIN_MCP_ALLOWED_SCOPES='["linkedin.jobs.search","linkedin.jobs.read","linkedin.people.search","linkedin.people.read","linkedin.companies.search","linkedin.companies.read"]'
# Explicit opt-in example for post and discussion research:
# LINKEDIN_MCP_ALLOWED_SURFACES='["content-search","post-detail","post-discussion"]'
# LINKEDIN_MCP_ALLOWED_SCOPES='["linkedin.posts.search","linkedin.posts.read","linkedin.posts.comments.read"]'
# Explicit opt-in example for personal post creation, comments/replies, and reactions:
# LINKEDIN_MCP_ALLOWED_SURFACES='["post-composer","post-detail","post-discussion"]'
# LINKEDIN_MCP_ALLOWED_SCOPES='["linkedin.posts.create","linkedin.posts.comments.create","linkedin.posts.reactions.set"]'
# LINKEDIN_MCP_ALLOWED_EFFECTS='["prepare","write"]'
# Explicit opt-in example for every connection and messaging capability:
# LINKEDIN_MCP_ALLOWED_SURFACES='["job-search","job-detail","people-search","member-profile","connections","messaging"]'
# LINKEDIN_MCP_ALLOWED_SCOPES='["linkedin.jobs.search","linkedin.jobs.read","linkedin.people.search","linkedin.people.read","linkedin.connections.read","linkedin.invitations.read","linkedin.invitations.send","linkedin.invitations.accept","linkedin.invitations.ignore","linkedin.messaging.read","linkedin.messaging.send"]'
# LINKEDIN_MCP_ALLOWED_EFFECTS='["read","prepare","write"]'

LINKEDIN_MCP_QUEUE_CAPACITY=100
LINKEDIN_MCP_MINIMUM_NAVIGATION_INTERVAL_SECONDS=2
LINKEDIN_MCP_JOB_SEARCH_MAX_PAGES_PER_CALL=100
LINKEDIN_MCP_PEOPLE_SEARCH_MAX_PAGES_PER_CALL=100
LINKEDIN_MCP_PROFILE_MAX_DETAIL_PAGES_PER_CALL=20
LINKEDIN_MCP_COMPANY_SEARCH_MAX_PAGES_PER_CALL=100
LINKEDIN_MCP_POST_SEARCH_MAX_PAGES_PER_CALL=100
LINKEDIN_MCP_POST_COMMENTS_MAX_EXPANSION_ROUNDS_PER_CALL=20
LINKEDIN_MCP_INVITATIONS_MAX_SCROLL_ROUNDS_PER_CALL=100
LINKEDIN_MCP_CONNECTIONS_MAX_SCROLL_ROUNDS_PER_CALL=100
LINKEDIN_MCP_MESSAGING_MAX_SCROLL_ROUNDS_PER_CALL=100
# Opaque collection cursors are process-local, single-use, and filter-bound.
LINKEDIN_MCP_PAGINATION_CURSOR_TTL_SECONDS=900
LINKEDIN_MCP_PAGINATION_MAX_ACTIVE_CURSORS=64
LINKEDIN_MCP_PAGINATION_MAX_SEEN_ITEMS_PER_CURSOR=5000
LINKEDIN_MCP_ACTION_DRAFT_TTL_SECONDS=86400
# Both default to persistent per-user application data.
# LINKEDIN_MCP_ASSET_ROOT_PATH=/an/optional/custom/assets
# LINKEDIN_MCP_RUNTIME_LOCK_PATH=/an/optional/custom/runtime.lock

LINKEDIN_MCP_BROWSER_HEADLESS=true
LINKEDIN_MCP_BROWSER_TIMEOUT_SECONDS=20
LINKEDIN_MCP_LOGIN_TIMEOUT_SECONDS=900

LINKEDIN_MCP_TRANSPORT=stdio
LINKEDIN_MCP_HTTP_HOST=127.0.0.1
LINKEDIN_MCP_HTTP_PORT=8000
LINKEDIN_MCP_LOG_LEVEL=INFO
